# Образ для локальной разработки демо-сайта.
# Зависимости ставятся при старте контейнера, а не на этапе сборки:
# папка проекта монтируется с хоста, и node_modules должны оказаться там же,
# чтобы редактор видел типы и подсказки.
FROM node:22-alpine

WORKDIR /app

EXPOSE 5173

CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0"]
