{
  "name": "avito-onboarding-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n build,serve -c blue,green \"vite build --watch\" \"sirv dist --port 8082 --host 0.0.0.0 --cors --dev\"",
    "test": "vitest",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "sirv-cli": "^3.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
